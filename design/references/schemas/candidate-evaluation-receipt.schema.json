{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GrazianoGuiducci/d-nd-ux-ai-seed/schemas/candidate-evaluation-receipt.schema.json",
  "title": "Agentic UX Seed Candidate Evaluation Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "seedId",
    "seedStatusAtEvaluation",
    "seedVersionOrCommit",
    "target",
    "evaluator",
    "clauses",
    "decision",
    "conditions",
    "validity",
    "sideEffects",
    "receipt"
  ],
  "properties": {
    "schema": {
      "const": "agentic-ux-seed.evaluation-receipt.v0.1"
    },
    "seedId": {
      "type": "string",
      "minLength": 1
    },
    "seedStatusAtEvaluation": {
      "const": "candidate"
    },
    "seedVersionOrCommit": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["product", "surface", "environment"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["system", "method"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": {
            "enum": ["passed", "failed", "not_tested", "not_applicable"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "decision": {
      "enum": ["adopt", "adopt_with_conditions", "needs_evidence", "reject"]
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "recheckOn"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "recheckOn": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sideEffects": {
      "enum": ["none", "review-only", "real"]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": ["createdAt", "artifact"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "artifact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
